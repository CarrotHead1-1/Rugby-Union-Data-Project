    "-- count the number of matches in the match fact table \n",
    "select count(MatchKey), Competition\n",
    "from gold_dev.default.fact_match_results as fact_match\n",
    "join gold_dev.default.dim_competitions on fact_match.CompetitionId = dim_competitions.CompetitionId\n",
    "group by Competition\n"
   ]
