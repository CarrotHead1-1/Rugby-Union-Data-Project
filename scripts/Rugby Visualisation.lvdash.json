{
  "datasets": [
    {
      "name": "7754949b",
      "displayName": "Total Wins Per Season",
      "queryLines": [
        "-- Count the number of wins per season\r\n",
        "SELECT \r\n",
        "    s.Season,\r\n",
        "    SUM(CASE WHEN r.Result = 'Home Win' THEN 1 ELSE 0 END) AS Home_Wins,\r\n",
        "    SUM(CASE WHEN r.Result = 'Away Win' THEN 1 ELSE 0 END) AS Away_Wins,\r\n",
        "    SUM(CASE WHEN r.Result = 'Draw' THEN 1 ELSE 0 END) AS Draws\r\n",
        "FROM rugby_data_dev.rugby_gold.Match_Fact f\r\n",
        "JOIN rugby_data_dev.rugby_gold.Season_Dim s \r\n",
        "    ON f.Season_Id = s.Season_Id\r\n",
        "JOIN rugby_data_dev.rugby_gold.Result_Dim r \r\n",
        "    ON f.Result_Id = r.Result_Id\r\n",
        "GROUP BY s.Season\r\n",
        "ORDER BY s.Season;\r\n"
      ],
      "catalog": "rugby_data_dev",
      "schema": "rugby_gold"
    },
    {
      "name": "e1743a59",
      "displayName": "Wins by Each Team",
      "queryLines": [
        "-- Total number of wins and loses\r\n",
        "select \r\n",
        "    t.Team_Name,\r\n",
        "    SUM(CASE \r\n",
        "            WHEN r.Result = 'Home Win' and m.Home_Team_Id = t.Team_Id then 1\r\n",
        "            when r.Result = 'Away Win' and m.Away_Team_Id = t.Team_Id then 1\r\n",
        "            ELSE 0 \r\n",
        "        END) AS Wins,\r\n",
        "\r\n",
        "    sum(CASE \r\n",
        "            WHEN r.Result = 'Home Win' and m.Away_Team_Id = t.Team_Id then 1\r\n",
        "            when r.Result = 'Away Win' and m.Home_Team_Id = t.Team_Id then 1\r\n",
        "            ELSE 0 \r\n",
        "        END) AS Loses,\r\n",
        "\r\n",
        "    sum(case \r\n",
        "        when r.Result = 'Draw' and (m.Home_Team_Id = t.Team_Id or m.Away_Team_Id = t.Team_Id) then 1\r\n",
        "        else 0\r\n",
        "        end) as Draws\r\n",
        "\r\n",
        "from rugby_data_dev.rugby_gold.match_fact m\r\n",
        "join rugby_data_dev.rugby_gold.teams_dim t on t.Team_Id in (m.Home_Team_Id, m.Away_Team_Id)\r\n",
        "join rugby_data_dev.rugby_gold.result_dim r on m.Result_Id = r.Result_Id\r\n",
        "group by t.Team_Name\r\n",
        "order by Wins desc;\r\n",
        "\r\n",
        "-- aggregate all wins, loses and draws by season \r\n",
        "select \r\n",
        "    t.Team_Name as Team,\r\n",
        "    s.Season as Season,\r\n",
        "    SUM(CASE \r\n",
        "            WHEN r.Result = 'Home Win' and m.Home_Team_Id = t.Team_Id then 1\r\n",
        "            when r.Result = 'Away Win' and m.Away_Team_Id = t.Team_Id then 1\r\n",
        "            ELSE 0 \r\n",
        "        END) AS Wins,\r\n",
        "\r\n",
        "    sum(CASE \r\n",
        "            WHEN r.Result = 'Home Win' and m.Away_Team_Id = t.Team_Id then 1\r\n",
        "            when r.Result = 'Away Win' and m.Home_Team_Id = t.Team_Id then 1\r\n",
        "            ELSE 0 \r\n",
        "        END) AS Loses,\r\n",
        "\r\n",
        "    sum(case \r\n",
        "        when r.Result = 'Draw' and (m.Home_Team_Id = t.Team_Id or m.Away_Team_Id = t.Team_Id) then 1\r\n",
        "        else 0\r\n",
        "        end) as Draws\r\n",
        "\r\n",
        "from rugby_data_dev.rugby_gold.match_fact m\r\n",
        "join rugby_data_dev.rugby_gold.teams_dim t on t.Team_Id in (m.Home_Team_Id , m.Away_Team_Id)\r\n",
        "join rugby_data_dev.rugby_gold.result_dim r on m.Result_Id = r.Result_Id\r\n",
        "join rugby_data_dev.rugby_gold.season_dim s on s.Season_Id = m.Season_Id\r\n",
        "group by t.Team_Name, s.Season\r\n",
        "order by Season, Team desc;"
      ],
      "catalog": "rugby_data_dev",
      "schema": "rugby_gold"
    }
  ],
